{
  "connection": {
    "name": "BenchmarkSqlConnection",
    "inputs": {
      "connection_type": {
        "__dvt_type": "const",
        "value": "clickhouse"
      },
      "host": {
        "__dvt_type": "const",
        "value": "${DVT_BENCH_CH_HOST:-localhost}"
      },
      "port": {
        "__dvt_type": "const",
        "value": "${DVT_BENCH_CH_PORT:-8124}"
      },
      "database": {
        "__dvt_type": "const",
        "value": "testdb"
      },
      "user": {
        "__dvt_type": "const",
        "value": "testuser"
      },
      "password": {
        "__dvt_type": "const",
        "value": "${DVT_BENCH_CH_PASSWORD:-testpassword}"
      }
    }
  },
  "ensure_table": {
    "name": "BenchmarkEnsureTable",
    "inputs": {
      "connection": {
        "__dvt_type": "link",
        "node_id": "connection",
        "output_name": "connection"
      },
      "table_name": {
        "__dvt_type": "const",
        "value": "bench_write_wide"
      },
      "schema": {
        "__dvt_type": "const",
        "value": "wide_mixed"
      },
      "on_exists": {
        "__dvt_type": "const",
        "value": "recreate"
      }
    }
  },
  "data": {
    "name": "BenchmarkSyntheticDataFrame",
    "inputs": {
      "rows": {
        "__dvt_type": "const",
        "value": 1000000
      },
      "npartitions": {
        "__dvt_type": "const",
        "value": 16
      },
      "seed": {
        "__dvt_type": "const",
        "value": 42
      },
      "schema": {
        "__dvt_type": "const",
        "value": "wide_mixed"
      }
    }
  },
  "write": {
    "name": "WriteDataFrameToDBV4",
    "inputs": {
      "connection": {
        "__dvt_type": "link",
        "node_id": "connection",
        "output_name": "connection"
      },
      "df": {
        "__dvt_type": "link",
        "node_id": "data",
        "output_name": "output"
      },
      "table_name": {
        "__dvt_type": "const",
        "value": "bench_write_wide"
      },
      "write_mode": {
        "__dvt_type": "const",
        "value": "append"
      },
      "chunksize": {
        "__dvt_type": "const",
        "value": null
      },
      "async_insert": {
        "__dvt_type": "const",
        "value": false
      },
      "sync_column_descriptions": {
        "__dvt_type": "const",
        "value": false
      },
      "signal_in": {
        "__dvt_type": "link",
        "node_id": "ensure_table",
        "output_name": "signal_out"
      }
    }
  }
}
