{
  "connection": {
    "name": "BenchmarkSqlConnection",
    "inputs": {
      "connection_type": {
        "__dvt_type": "const",
        "value": "postgres"
      },
      "host": {
        "__dvt_type": "const",
        "value": "${DVT_BENCH_PG_HOST:-localhost}"
      },
      "port": {
        "__dvt_type": "const",
        "value": "${DVT_BENCH_PG_PORT:-54321}"
      },
      "database": {
        "__dvt_type": "const",
        "value": "testdb"
      },
      "user": {
        "__dvt_type": "const",
        "value": "testuser"
      },
      "password": {
        "__dvt_type": "const",
        "value": "${DVT_BENCH_PG_PASSWORD:-testpassword}"
      }
    }
  },
  "ensure_a": {
    "name": "BenchmarkEnsureTable",
    "inputs": {
      "connection": {
        "__dvt_type": "link",
        "node_id": "connection",
        "output_name": "connection"
      },
      "table_name": {
        "__dvt_type": "const",
        "value": "bench_write_a"
      },
      "schema": {
        "__dvt_type": "const",
        "value": "wide_mixed"
      },
      "on_exists": {
        "__dvt_type": "const",
        "value": "recreate"
      }
    }
  },
  "data_a": {
    "name": "BenchmarkSyntheticDataFrame",
    "inputs": {
      "rows": {
        "__dvt_type": "const",
        "value": 5000000
      },
      "npartitions": {
        "__dvt_type": "const",
        "value": 64
      },
      "seed": {
        "__dvt_type": "const",
        "value": 42
      },
      "schema": {
        "__dvt_type": "const",
        "value": "wide_mixed"
      }
    }
  },
  "write_a": {
    "name": "WriteDataFrameToDBV4",
    "inputs": {
      "connection": {
        "__dvt_type": "link",
        "node_id": "connection",
        "output_name": "connection"
      },
      "df": {
        "__dvt_type": "link",
        "node_id": "data_a",
        "output_name": "output"
      },
      "table_name": {
        "__dvt_type": "const",
        "value": "bench_write_a"
      },
      "write_mode": {
        "__dvt_type": "const",
        "value": "append"
      },
      "chunksize": {
        "__dvt_type": "const",
        "value": 1000
      },
      "rows_per_batch": {
        "__dvt_type": "const",
        "value": null
      },
      "sync_column_descriptions": {
        "__dvt_type": "const",
        "value": false
      },
      "signal_in": {
        "__dvt_type": "link",
        "node_id": "ensure_a",
        "output_name": "signal_out"
      }
    }
  },
