{
  "data": {
    "name": "BenchmarkSyntheticDataFrame",
    "inputs": {
      "rows": {
        "__dvt_type": "const",
        "value": 1000000
      },
      "npartitions": {
        "__dvt_type": "const",
        "value": 16
      },
      "seed": {
        "__dvt_type": "const",
        "value": 42
      },
      "schema": {
        "__dvt_type": "const",
        "value": "wide_mixed"
      }
    }
  },
  "lag": {
    "name": "DataFrameLagColumns",
    "inputs": {
      "df": {
        "__dvt_type": "link",
        "node_id": "data",
        "output_name": "output"
      },
      "columns_to_lag": {
        "__dvt_type": "const",
        "value": [
          "float_a",
          "amount"
        ]
      },
      "lag_steps": {
        "__dvt_type": "const",
        "value": 1
      },
      "fill_value": {
        "__dvt_type": "const",
        "value": 0
      }
    }
  },
  "materialize": {
    "name": "BenchmarkMaterialize",
    "inputs": {
      "df": {
        "__dvt_type": "link",
        "node_id": "lag",
        "output_name": "output"
      },
      "mode": {
        "__dvt_type": "const",
        "value": "count_rows"
      },
      "num_workers": {
        "__dvt_type": "const",
        "value": 8
      }
    }
  }
