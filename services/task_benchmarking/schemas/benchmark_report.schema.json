{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dvt.local/schemas/memory-benchmark/benchmark_report.schema.json",
  "title": "MemoryBenchmarkReport",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "mode",
    "pipeline_path",
    "status"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "type": "string",
      "enum": [
        "single",
        "repeat",
        "validate_only",
        "dry_run",
        "matrix"
      ]
    },
    "pipeline_path": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "success",
        "error"
      ]
    },
    "report": {
      "type": "object"
    },
    "repeat": {
      "type": "integer",
      "minimum": 1
    },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "run",
          "status"
        ],
        "properties": {
          "run": {
            "type": "integer",
            "minimum": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "success",
              "error"
            ]
          },
          "duration_s": {
            "type": [
              "number",
              "null"
            ]
          },
          "rss_start_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "rss_end_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "rss_peak_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "rss_delta_bytes": {
            "type": "integer"
          },
          "report": {
            "type": "object"
          }
        },
        "additionalProperties": true
      }
    },
    "validation": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
